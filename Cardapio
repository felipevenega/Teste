<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deck Natural - Cardápio Digital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        .category-pill.active {
            background-color: #059669;
            color: white;
        }

        .product-card:active {
            transform: scale(0.98);
        }

        .custom-shadow {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .cart-animation {
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }

        /* Estilo para o botão do WhatsApp */
        .whatsapp-float {
            position: fixed;
            bottom: 100px; /* Acima da barra de carrinho */
            right: 20px;
            background-color: #25d366;
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
            z-index: 40;
            transition: transform 0.2s;
        }
        
        .whatsapp-float:active {
            transform: scale(0.9);
        }
    </style>
</head>
<body class="pb-24">

    <!-- Header -->
    <header class="bg-white border-b sticky top-0 z-50">
        <div class="max-w-md mx-auto px-4 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold text-emerald-800">DECK NATURAL</h1>
                <p class="text-xs text-gray-500 font-medium tracking-wide">MESA 13</p>
            </div>
            <button class="bg-emerald-50 p-2 rounded-full text-emerald-600">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>
        
        <!-- Categorias -->
        <div class="flex overflow-x-auto no-scrollbar gap-2 px-4 pb-3 mt-2">
            <button onclick="filterCategory('todos')" class="category-pill active whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-semibold transition-all">Todos</button>
            <button onclick="filterCategory('lanches')" class="category-pill bg-white border whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600 transition-all">Lanches</button>
            <button onclick="filterCategory('sucos')" class="category-pill bg-white border whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600 transition-all">Sucos Naturais</button>
            <button onclick="filterCategory('porcoes')" class="category-pill bg-white border whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600 transition-all">Porções</button>
            <button onclick="filterCategory('sobremesas')" class="category-pill bg-white border whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-semibold text-gray-600 transition-all">Sobremesas</button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-md mx-auto px-4 mt-6">
        <div id="product-list" class="space-y-4">
            <!-- Os produtos serão injetados aqui pelo JavaScript -->
        </div>
    </main>

    <!-- Botão Flutuante WhatsApp -->
    <a href="#" id="whatsapp-link" onclick="sendWhatsApp(event)" class="whatsapp-float">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- Floating Cart Bar -->
    <div id="cart-bar" class="fixed bottom-0 left-0 right-0 bg-white border-t p-4 hidden z-50 cart-animation">
        <div class="max-w-md mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <i class="fa-solid fa-basket-shopping text-2xl text-emerald-600"></i>
                    <span id="cart-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold">0</span>
                </div>
                <div>
                    <p class="text-xs text-gray-500">Total do pedido</p>
                    <p id="cart-total" class="font-bold text-lg text-gray-800">R$ 0,00</p>
                </div>
            </div>
            <button onclick="sendWhatsApp(event)" class="bg-emerald-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-emerald-700 transition-colors">
                Pedir agora
            </button>
        </div>
    </div>

    <script>
        const products = [
            { id: 1, name: "Burger Natural Pro", price: 34.90, category: "lanches", desc: "Pão artesanal, hambúrguer de grão de bico, queijo coalho e rúcula.", image: "🍔" },
            { id: 2, name: "Suco de Laranja 500ml", price: 12.00, category: "sucos", desc: "Suco natural feito na hora, sem adição de açúcar.", image: "🍊" },
            { id: 3, name: "Batata Rústica", price: 28.50, category: "porcoes", desc: "Acompanha maionese verde da casa e alecrim.", image: "🍟" },
            { id: 4, name: "Bowl de Açaí", price: 22.00, category: "sobremesas", desc: "Açaí puro, granola artesanal e frutas da estação.", image: "🍓" },
            { id: 5, name: "X-Salada Especial", price: 29.90, category: "lanches", desc: "Blend bovino 150g, queijo prato, tomate e alface.", image: "🥪" },
            { id: 6, name: "Suco Detox Verde", price: 15.00, category: "sucos", desc: "Couve, limão, gengibre e maçã.", image: "🥤" }
        ];

        let cart = [];
        // Número atualizado conforme solicitado
        const phone = "5515991694327"; 
        const mesa = "13";

        function renderProducts(items) {
            const list = document.getElementById('product-list');
            list.innerHTML = items.map(p => `
                <div class="product-card bg-white p-4 rounded-2xl flex gap-4 custom-shadow border border-gray-100 transition-transform active:scale-95">
                    <div class="w-20 h-20 bg-emerald-50 rounded-xl flex items-center justify-center text-3xl shrink-0">
                        ${p.image}
                    </div>
                    <div class="flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="font-bold text-gray-800">${p.name}</h3>
                            <p class="text-xs text-gray-500 mt-1 leading-tight">${p.desc}</p>
                        </div>
                        <div class="flex justify-between items-end mt-2">
                            <span class="font-bold text-emerald-700">R$ ${p.price.toFixed(2).replace('.', ',')}</span>
                            <button onclick="addToCart(${p.id})" class="bg-emerald-600 text-white w-8 h-8 rounded-lg flex items-center justify-center hover:bg-emerald-700">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function filterCategory(cat) {
            document.querySelectorAll('.category-pill').forEach(btn => {
                btn.classList.remove('active', 'bg-emerald-600', 'text-white');
                btn.classList.add('bg-white', 'text-gray-600', 'border');
            });
            
            const target = event.currentTarget;
            target.classList.add('active', 'text-white');
            target.classList.remove('bg-white', 'text-gray-600', 'border');

            if (cat === 'todos') {
                renderProducts(products);
            } else {
                renderProducts(products.filter(p => p.category === cat));
            }
        }

        function addToCart(id) {
            const product = products.find(p => p.id === id);
            cart.push(product);
            updateCartUI();
        }

        function updateCartUI() {
            const cartBar = document.getElementById('cart-bar');
            const cartCount = document.getElementById('cart-count');
            const cartTotal = document.getElementById('cart-total');

            if (cart.length > 0) {
                cartBar.classList.remove('hidden');
                cartCount.innerText = cart.length;
                const total = cart.reduce((sum, p) => sum + p.price, 0);
                cartTotal.innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
            } else {
                cartBar.classList.add('hidden');
            }
        }

        function sendWhatsApp(e) {
            e.preventDefault();
            
            let message = `Olá! Gostaria de fazer um pedido.\n*Mesa:* ${mesa}\n\n`;
            
            if (cart.length > 0) {
                message += `*Itens:*\n`;
                const summary = cart.reduce((acc, curr) => {
                    acc[curr.name] = (acc[curr.name] || 0) + 1;
                    return acc;
                }, {});
                
                for (const [name, qty] of Object.entries(summary)) {
                    message += `- ${qty}x ${name}\n`;
                }
                
                const total = cart.reduce((sum, p) => sum + p.price, 0);
                message += `\n*Total:* R$ ${total.toFixed(2).replace('.', ',')}`;
            } else {
                message += "Ainda não selecionei os itens, pode me enviar o cardápio em PDF?";
            }

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phone}?text=${encodedMessage}`, '_blank');
        }

        window.onload = () => {
            renderProducts(products);
        };
    </script>
</body>
</html>
